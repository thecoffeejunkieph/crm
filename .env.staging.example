# Staging environment variables.
# Copy to .env.staging (or set these directly in your host/orchestrator's secret
# store) and fill in real values. application-staging.properties has NO fallbacks,
# so the app refuses to start if any of these are missing.

SPRING_PROFILES_ACTIVE=staging

# --- Database ---
DB_HOST=postgres
DB_OWNER_USERNAME=crm_owner
DB_OWNER_PASSWORD=<staging-owner-password>
DB_APP_USERNAME=crm_app
DB_APP_PASSWORD=<staging-app-password>

# --- Crypto (env-only, generate unique random values - do not reuse dev/prod) ---
ENCRYPTION_SALT=<staging-only-random-salt>
ENCRYPTION_KEY=<staging-only-random-key>
SESSION_COOKIE_SECURE=true
# XSRF-TOKEN cookie domain. Every subdomain of it can read the token, so all subdomains must be trusted.
CSRF_COOKIE_DOMAIN=<staging-parent-domain>
# Emails this address an ADMIN invite when app_user is empty. Leave empty afterwards.
BOOTSTRAP_ADMIN_EMAIL=

# --- Storage ---
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_HOST=staging-files.thecoffeejunkie.ph
MINIO_PUBLIC_URL=https://staging-files.thecoffeejunkie.ph
MINIO_ACCESS_KEY=<staging-minio-access-key>
MINIO_SECRET_KEY=<staging-minio-secret-key>

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=<staging-redis-password>

# --- Public URLs ---
APP_BASE_URL=https://staging-api.thecoffeejunkie.ph
APP_FRONTEND_URL=https://staging.thecoffeejunkie.ph
CORS_ALLOWED_ORIGINS=https://staging.thecoffeejunkie.ph

# --- Mail (quotation emails) ---
MAIL_USERNAME=<staging-smtp-username>
MAIL_PASSWORD=<staging-smtp-password>
