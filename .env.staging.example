# Staging environment variables.
# Copy to .env.staging (or set these directly in your host/orchestrator's secret
# store) and fill in real values. application-staging.properties has NO fallbacks,
# so the app refuses to start if any of these are missing.

SPRING_PROFILES_ACTIVE=staging

# --- Database ---
DB_URL=jdbc:mysql://<staging-db-host>:3306/crm_db
DB_USERNAME=<staging-db-username>
DB_PASSWORD=<staging-db-password>

# --- Auth / crypto (generate unique, random values - do not reuse dev/prod) ---
AUTH_SECRET_KEY=<staging-only-random-secret>
ENCRYPTION_SALT=<staging-only-random-salt>
COOKIE_SECURE=true

# --- Storage ---
PDF_STORAGE_DIR=/data/storage

# --- Public URLs ---
APP_BASE_URL=https://staging-api.thecoffeejunkie.ph
CORS_ALLOWED_ORIGINS=https://staging.thecoffeejunkie.ph

# --- Mail (quotation emails) ---
MAIL_USERNAME=<staging-smtp-username>
MAIL_PASSWORD=<staging-smtp-password>

# --- Quotation response links ---
QUOTATION_RESPONSE_SECRET=<staging-only-random-secret>

# --- Invoice proof-of-payment links ---
INVOICE_PAYMENT_SECRET=<staging-only-random-secret>

# --- Invoice bank details (shown on generated invoice PDFs) ---
INVOICE_BANK_NAME=<staging-bank-name>
INVOICE_BANK_ACCOUNT_NAME=<staging-bank-account-name>
INVOICE_BANK_ACCOUNT_NUMBER=<staging-bank-account-number>
INVOICE_BANK_SWIFT_CODE=<staging-bank-swift-code>
