# Local development environment variables.
# Copy to .env.dev and adjust as needed - every value here already has a safe
# fallback in application-dev.properties, so .env.dev is optional for local work.

SPRING_PROFILES_ACTIVE=dev

# --- Database (compose: docker-compose.prod.yml / docker-compose.local.yml) ---
DB_HOST=localhost
DB_OWNER_USERNAME=crm_owner
DB_OWNER_PASSWORD=crm_owner
DB_APP_USERNAME=crm_app
DB_APP_PASSWORD=crm_app

# --- Crypto (env-only: no defaults in committed properties outside the dev profile) ---
ENCRYPTION_SALT=secretkeyngsolsticecoffee1234567890
ENCRYPTION_KEY=dev-only-encryption-key-change-me
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@local.test

# --- Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Redis ---
REDIS_HOST=localhost
REDIS_PASSWORD=devredis

# --- Public URLs ---
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mail ---
# The dev profile sends to Mailpit (localhost:1025, UI http://localhost:8025); nothing to configure.
