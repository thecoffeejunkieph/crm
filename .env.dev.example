# Local development environment variables.
# Copy to .env.dev and adjust as needed - every value here already has a safe
# fallback in application-dev.properties, so .env.dev is optional for local work.

SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/crm_db
DB_USERNAME=admin
DB_PASSWORD=admin

# --- Auth / crypto ---
