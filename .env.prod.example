# Production environment variables.
# Copy to .env.prod (or, preferably, set these via your host/orchestrator's secret
# store rather than a file on disk) and fill in real values.
# application-prod.properties has NO fallbacks, so the app refuses to start if any
# of these are missing.

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_URL=jdbc:mysql://<prod-db-host>:3306/crm_db
DB_USERNAME=<prod-db-username>
DB_PASSWORD=<prod-db-password>

# --- Auth / crypto (generate unique, random values - do not reuse dev/staging) ---
AUTH_SECRET_KEY=<prod-only-random-secret>
ENCRYPTION_SALT=<prod-only-random-salt>
COOKIE_SECURE=true

# --- Storage ---
PDF_STORAGE_DIR=/data/storage

# --- Public URLs ---
APP_BASE_URL=https://api.thecoffeejunkie.ph
CORS_ALLOWED_ORIGINS=https://crm.thecoffeejunkie.ph

# --- Mail (quotation emails) ---
MAIL_USERNAME=sales@thecoffeejunkie.ph
MAIL_PASSWORD=<prod-smtp-password>

# --- Quotation response links ---
QUOTATION_RESPONSE_SECRET=<prod-only-random-secret>

# --- Invoice proof-of-payment links ---
INVOICE_PAYMENT_SECRET=<prod-only-random-secret>
